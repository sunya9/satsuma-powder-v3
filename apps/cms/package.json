{
  "name": "cms",
  "version": "1.0.0",
  "description": "Payload CMS admin for satsuma-powder-v3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "ci": "payload migrate && pnpm run build:cf",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "pnpm run build:cf && opennextjs-cloudflare preview",
    "smoke": "bash scripts/smoke-test.sh",
    "migrate": "payload migrate",
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "payload generate:types",
    "lint": "oxlint .",
    "format": "oxfmt",
    "seed:admin": "payload run src/seed/admin.ts",
    "seed:api-key": "payload run src/seed/api-key.ts",
    "payload": "payload",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:int": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@payloadcms/db-sqlite": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-seo": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-r2": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "graphql": "^17.0.2",
    "next": "16.4.3",
    "payload": "3.92.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "^11"
  }
}
