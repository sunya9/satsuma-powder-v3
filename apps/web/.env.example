# Payload CMS base URL — build-time data source (SSG fetches here)
PAYLOAD_URL=http://localhost:3000
# Public site URL — canonical / OGP (defaults to localhost in dev)
SITE_URL=https://example.com
# Payload API key for the build user. Read from the environment at build time
# and never inlined into any bundle, unlike the values above (inlined by
# vite.config.ts). Must match the cms build user's apiKey.
PAYLOAD_API_KEY=
